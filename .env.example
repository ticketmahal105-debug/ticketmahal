# Supabase Configuration
VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Payment Architecture Mode: 'demo' | 'ngenius'
PAYMENT_MODE=demo

# Email Delivery Configuration (Resend)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Ticket Mahal <tickets@ticketmahal.ae>

# Server-Side N-Genius Payment Gateway (Network International) Configuration
NGENIUS_OUTLET_ID=77df254a-a9c0-4b1c-88d5-6b3f2c8e35ac
NGENIUS_API_KEY=your_base64_api_key_here
NGENIUS_ENV=live
NGENIUS_REDIRECT_URL=https://ticketmahal.ae/payment/callback
NGENIUS_WEBHOOK_SECRET=your_webhook_secret_here

# Public Gateway Configuration
VITE_NGENIUS_OUTLET_ID=77df254a-a9c0-4b1c-88d5-6b3f2c8e35ac
